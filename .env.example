# Learning/demo credentials only. Change before deployment; NEVER commit .env.
DATABASE_URL=postgresql+psycopg://findata:localpass@db:5432/findata
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
